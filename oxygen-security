<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oxygen Security - PutaiaoTech Assist</title>

<!-- Styling -->
<style>
  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(180deg, #0f1f0f, #061306);
    color: #ffffff;
  }
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 20px;
  }
  .title {
    text-align: center;
    font-size: 28px;
    font-weight: bold;
    color: #c2a55c;
    margin-bottom: 20px;
  }
  .form-section {
    background: linear-gradient(145deg, #1a1a1a, #101010);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
  }
  label {
    display: block;
    margin: 10px 0 5px;
  }
  input, select {
    width: 100%;
    padding: 8px;
    border-radius: 5px;
    border: none;
    margin-bottom: 10px;
  }
  .btn {
    display: inline-block;
    background: linear-gradient(180deg,#5edb63,#2e9e36);
    color: white;
    padding: 10px 18px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    margin-right: 10px;
    cursor: pointer;
    transition: 0.2s;
  }
  .btn:hover {
    background: linear-gradient(180deg,#6fff73,#35b63f);
  }
</style>
</head>

<body>
<div class="container">
  <div class="title">Oxygen Security - PutaiaoTech Assist</div>

  <div class="form-section">
    <form id="oxygenForm">
      <!-- Environment Selection -->
      <label>Select Environment:</label>
      <select id="environment">
        <option value="">--Select Environment--</option>
        <option value="freshwater">Freshwater / Rain</option>
        <option value="ocean">Ocean / Marine</option>
        <option value="air">Air / Atmosphere</option>
        <option value="lab">Lab / Outside Tracking</option>
      </select>

      <!-- Monitoring Type -->
      <label>Select Monitoring Type:</label>
      <select id="monitoringType">
        <option value="">--Select Type--</option>
        <option value="standard">Standard Oxygen Monitoring</option>
        <option value="nuclear">Nuclear Contamination / Oxygen Impact</option>
      </select>

      <!-- Adaptive Data Fields -->
      <div id="dataFields">
        <!-- Fields will appear here based on selection -->
      </div>

      <button type="button" class="btn" onclick="saveCSV()">Save to USB (CSV)</button>
      <button type="button" class="btn" onclick="generatePDF()">Generate PDF Report</button>
    </form>
  </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
  const environment = document.getElementById('environment');
  const monitoringType = document.getElementById('monitoringType');
  const dataFields = document.getElementById('dataFields');

  function createInput(labelText, id, type='number', step='0.1') {
    return `
      <label for="${id}">${labelText}</label>
      <input type="${type}" id="${id}" step="${step}">
    `;
  }

  function updateFields() {
    const env = environment.value;
    const type = monitoringType.value;
    let html = '';

    if (!env || !type) {
      dataFields.innerHTML = '';
      return;
    }

    if(env === 'freshwater' || env === 'ocean'){
      html += createInput('Dissolved Oxygen (mg/L)','do');
      html += createInput('Temperature (°C)','temp');
      html += createInput('pH','ph');
      html += createInput('Turbidity (NTU)','turbidity');
      if(type==='nuclear'){
        html += createInput('Radiation Level (µSv/h)','radiation');
      }
    } else if(env === 'air'){
      html += createInput('Oxygen Level (ppm)','o2');
      html += createInput('Temperature (°C)','temp');
      html += createInput('Humidity (%)','humidity');
      if(type==='nuclear'){
        html += createInput('Radiation Level (µSv/h)','radiation');
      }
    } else if(env === 'lab'){
      html += createInput('Sample DO (mg/L)','do');
      html += createInput('Temperature (°C)','temp');
      html += createInput('Notes','notes','text');
      if(type==='nuclear'){
        html += createInput('Radiation Level (µSv/h)','radiation');
      }
    }

    dataFields.innerHTML = html;
  }

  environment.addEventListener('change', updateFields);
  monitoringType.addEventListener('change', updateFields);

  function saveCSV() {
    const form = document.getElementById('oxygenForm');
    const values = {};
    const inputs = form.querySelectorAll('input, select');
    inputs.forEach(input => {
      values[input.id] = input.value;
    });

    let csv = 'Parameter,Value\n';
    for (const key in values) {
      if(values[key] !== '') csv += `${key},${values[key]}\n`;
    }

    const blob = new Blob([csv], {type: 'text/csv'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'oxygen-security-data.csv';
    a.click();
    URL.revokeObjectURL(url);
    alert('CSV saved. Please copy to your USB.');
  }

  async function generatePDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('Oxygen Security Report - PutaiaoTech Assist', 10, 20);

    const form = document.getElementById('oxygenForm');
    let y = 30;
    const inputs = form.querySelectorAll('input, select');
    inputs.forEach(input => {
      doc.setFontSize(12);
      doc.text(`${input.id}: ${input.value}`, 10, y);
      y += 10;
    });

    doc.save('oxygen-security-report.pdf');
    alert('PDF report generated. Please copy to your USB.');
  }
</script>

</body>
</html>
